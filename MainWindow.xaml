<Window x:Class="MagentaBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Magenta Bridge"
        Height="646" Width="720"
        MinHeight="660" MinWidth="620"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{DynamicResource Font.Ui}"
        PreviewKeyDown="OnPreviewKeyDown">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6"
                        GlassFrameThickness="0" CornerRadius="18"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <!-- The window edge is rounded and stroked by DWM (WindowChrome). Drawing our own border
       here produced a second, slightly different arc at the corners in light mode. -->
  <Border BorderThickness="0" CornerRadius="0">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- header: wordmark, live status, window controls -->
    <Grid Grid.Row="0" Margin="22,0,8,0" Background="Transparent">
      <!-- wordmark with the device named beneath it: the product is Magenta Bridge,
           the panel it serves is the qualifier -->
      <StackPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Border Width="7" Height="7" CornerRadius="2" Background="{DynamicResource Brush.Accent}"
                  VerticalAlignment="Center" />
          <TextBlock Text="MAGENTA" FontSize="15" FontWeight="SemiBold" Margin="9,0,0,0"
                     VerticalAlignment="Center" />
          <TextBlock Text="BRIDGE" FontSize="15" Foreground="{DynamicResource Brush.Muted}" Margin="5,0,0,0"
                     VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="DeviceSubtitle" Text="Octavi IFR-1" FontSize="9" Margin="16,1,0,0"
                   Foreground="{DynamicResource Brush.Dim}" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
          <Ellipse x:Name="DeviceDot" Width="6" Height="6" Fill="{DynamicResource Brush.Bad}"
                   VerticalAlignment="Center" />
          <TextBlock x:Name="DeviceText" Text="IFR-1" FontSize="9" VerticalAlignment="Center"
                     Margin="6,0,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
          <Ellipse x:Name="SimDot" Width="6" Height="6" Fill="{DynamicResource Brush.Bad}"
                   VerticalAlignment="Center" />
          <TextBlock x:Name="SimText" Text="MSFS" FontSize="9" VerticalAlignment="Center"
                     Margin="6,0,0,0" />
        </StackPanel>
        <Button x:Name="MinimiseButton" Style="{StaticResource IconButton}" Content="—"
                FontFamily="Segoe UI Symbol" FontSize="12" Margin="2,0,0,0"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimise" ToolTip="Minimise" />
        <Button x:Name="MaximiseButton" Style="{StaticResource IconButton}" Content="□"
                FontFamily="Segoe UI Symbol" FontSize="12" Margin="2,0,0,0"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMaximise" ToolTip="Maximise" />
        <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="✕"
                FontFamily="Segoe UI Symbol" FontSize="12" Margin="2,0,0,0"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseWindow" ToolTip="Close" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="20,8,20,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="StatusLine" Grid.Row="0" FontSize="9" Foreground="{DynamicResource Brush.Muted}"
               Margin="2,0,0,10" TextTrimming="CharacterEllipsis" />

    <!-- body -->
    <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

        <!-- first run: what this is and what to do first -->
        <Border x:Name="WelcomeStrip" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="WELCOME" FontSize="9" Foreground="{DynamicResource Brush.Dim}" />
            <TextBlock Text="An independent alternative to Octavi's own plug-in. Your IFR-1 talks to MSFS directly - no MobiFlight."
                       FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBlock Text="The eight context buttons pick the mode; press the rotary knob to shift. Start with Test your panel to check every control."
                       FontSize="11" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button x:Name="PrimaryWelcome" Style="{StaticResource PrimaryButton}" Click="OnVerifyPanel"
                      Margin="0,0,8,0">
                <TextBlock x:Name="PrimaryWelcomeText" Text="Test your panel"
                           Foreground="{DynamicResource Brush.OnAccent}" />
              </Button>
              <Button Content="Got it" Click="OnDismissWelcome" Margin="0" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- the usual first-run trap: two programs cannot share the panel -->
        <Border x:Name="ConflictStrip" Style="{StaticResource Card}" Visibility="Collapsed"
                BorderBrush="{DynamicResource Brush.Warn}">
          <StackPanel>
            <TextBlock Text="OCTAVI PLUG-IN RUNNING" FontSize="10"
                       Foreground="{DynamicResource Brush.Warn}" />
            <TextBlock Text="Octavi's own plug-in is running and is holding the panel. Quit it from the tray, then press Reload config - otherwise controls will do nothing."
                       FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="Close Octavi plug-in" Click="OnCloseVendorPlugin" Margin="0,0,8,0" />
              <Button Content="Check again" Click="OnRecheckPlugin" Margin="0" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- HERO: mode and the radio stack -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Border Width="28" Height="2" CornerRadius="1" HorizontalAlignment="Left"
                    Background="{DynamicResource Brush.Accent}" Margin="0,0,0,12" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock x:Name="ModeLabelText" Text="COM1" FontSize="30" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ShiftChip" Text="SHIFT" FontSize="11" FontWeight="SemiBold"
                           Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.45"
                           Foreground="{DynamicResource Brush.Muted}" />
                <StackPanel x:Name="DialStrip" Orientation="Horizontal" Margin="16,0,0,0"
                            VerticalAlignment="Center">
                  <TextBlock Text="&lt;" FontSize="10" Foreground="{DynamicResource Brush.Muted}"
                             VerticalAlignment="Center" />
                  <TextBlock x:Name="Dial1Text" Text="0" FontSize="10" Width="20" TextAlignment="Center"
                             Foreground="{DynamicResource Brush.Muted}" />
                  <TextBlock Text="&gt;" FontSize="10" Foreground="{DynamicResource Brush.Muted}"
                             VerticalAlignment="Center" />
                  <TextBlock x:Name="Dial2Text" Text="0" FontSize="10" Width="20" TextAlignment="Center"
                             Foreground="{DynamicResource Brush.Muted}" Margin="6,0,0,0" />
                </StackPanel>
              </StackPanel>

              <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Ellipse x:Name="ActivityDot" Width="6" Height="6" Margin="0,0,6,0"
                           VerticalAlignment="Center" Fill="{DynamicResource Brush.Accent}" Opacity="0.18" />
                  <TextBlock x:Name="ModeText" Text="-" FontSize="11" VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.Muted}" />
                </StackPanel>
                <StackPanel x:Name="ModePips" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,6,0,0"
                            ToolTip="Position among the panel's eight context buttons" />
              </StackPanel>
            </Grid>

            <Border Height="1" Background="{DynamicResource Brush.Stroke}" Margin="0,14,0,12" />

            <Grid x:Name="StackGrid" Margin="0,2,0,0" HorizontalAlignment="Left">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="140" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="COM1" FontSize="11" Margin="0,3,0,3"
                         VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" />
              <TextBlock Grid.Row="0" Grid.Column="1" x:Name="Com1A" Text="---" FontSize="13"
                         FontFamily="{StaticResource Font.Mono}" HorizontalAlignment="Right"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Row="0" Grid.Column="2" Text="&gt;" FontSize="11" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
              <TextBlock Grid.Row="0" Grid.Column="3" x:Name="Com1S" Text="---" FontSize="13"
                         FontFamily="{StaticResource Font.Mono}" HorizontalAlignment="Right"
                         VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="COM2" FontSize="11" Margin="0,3,0,12"
                         VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" />
              <TextBlock Grid.Row="1" Grid.Column="1" x:Name="Com2A" Text="---" FontSize="13"
                         FontFamily="{StaticResource Font.Mono}" HorizontalAlignment="Right"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="&gt;" FontSize="11" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
              <TextBlock Grid.Row="1" Grid.Column="3" x:Name="Com2S" Text="---" FontSize="13"
                         FontFamily="{StaticResource Font.Mono}" HorizontalAlignment="Right"
                         VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="NAV1" FontSize="11" Margin="0,3,0,3"
                         VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" />
              <TextBlock Grid.Row="2" Grid.Column="1" x:Name="Nav1A" Text="---" FontSize="13"
                         FontFamily="{StaticResource Font.Mono}" HorizontalAlignment="Right"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Row="2" Grid.Column="2" Text="&gt;" FontSize="11" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
              <TextBlock Grid.Row="2" Grid.Column="3" x:Name="Nav1S" Text="---" FontSize="13"
                         FontFamily="{StaticResource Font.Mono}" HorizontalAlignment="Right"
                         VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" />
              <TextBlock Grid.Row="2" Grid.Column="4" x:Name="Nav1X" Text="" FontSize="11"
                         FontFamily="{StaticResource Font.Mono}" Margin="12,0,0,0"
                         VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" />

              <TextBlock Grid.Row="3" Grid.Column="0" Text="NAV2" FontSize="11" Margin="0,3,0,12"
                         VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" />
              <TextBlock Grid.Row="3" Grid.Column="1" x:Name="Nav2A" Text="---" FontSize="13"
                         FontFamily="{StaticResource Font.Mono}" HorizontalAlignment="Right"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Row="3" Grid.Column="2" Text="&gt;" FontSize="11" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
              <TextBlock Grid.Row="3" Grid.Column="3" x:Name="Nav2S" Text="---" FontSize="13"
                         FontFamily="{StaticResource Font.Mono}" HorizontalAlignment="Right"
                         VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" />
              <TextBlock Grid.Row="3" Grid.Column="4" x:Name="Nav2X" Text="" FontSize="11"
                         FontFamily="{StaticResource Font.Mono}" Margin="12,0,0,0"
                         VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" />

              <TextBlock Grid.Row="4" Grid.Column="0" Text="HDG" FontSize="11" Margin="0,3,0,3"
                         VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" />
              <TextBlock Grid.Row="4" Grid.Column="1" x:Name="HdgV" Text="---" FontSize="13"
                         FontFamily="{StaticResource Font.Mono}" HorizontalAlignment="Right"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2" x:Name="BaroV" Text="" FontSize="11"
                         FontFamily="{StaticResource Font.Mono}" Margin="12,0,0,0"
                         VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" />

              <TextBlock Grid.Row="5" Grid.Column="0" Text="XPDR" FontSize="11" Margin="0,3,0,0"
                         VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" />
              <TextBlock Grid.Row="5" Grid.Column="1" x:Name="XpdrCode" Text="----" FontSize="13"
                         FontFamily="{StaticResource Font.Mono}" HorizontalAlignment="Right"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Row="5" Grid.Column="3" Grid.ColumnSpan="2" x:Name="XpdrMode" Text="" FontSize="11"
                         Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>

            <TextBlock x:Name="EmptyText" Text="Waiting for Microsoft Flight Simulator. Start the sim and load a flight."
                       FontSize="13" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,2"
                       Visibility="Collapsed" />
          </StackPanel>
        </Border>

        <!-- autopilot: indicator dots, not buttons -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <TextBlock Text="AUTOPILOT" FontSize="9" Foreground="{DynamicResource Brush.Dim}"
                         VerticalAlignment="Center" />
              <StackPanel x:Name="ApValues" Orientation="Horizontal" HorizontalAlignment="Right"
                          Visibility="Collapsed">
                <TextBlock x:Name="AltText" Text="-" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="VsText" Text="-" FontSize="11" Margin="12,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" />
              </StackPanel>
            </Grid>

            <UniformGrid Columns="6" Margin="0,12,0,0">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="LampMaster" Width="9" Height="9" VerticalAlignment="Center"
                         Fill="{DynamicResource Brush.Bad}" />
                <TextBlock x:Name="LampMasterText" Text="MASTER" FontSize="10" Margin="8,0,0,0"
                           Foreground="{DynamicResource Brush.Muted}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="LampHdg" Width="9" Height="9" VerticalAlignment="Center"
                         Fill="{DynamicResource Brush.Bad}" />
                <TextBlock x:Name="LampHdgText" Text="HDG" FontSize="10" Margin="8,0,0,0"
                           Foreground="{DynamicResource Brush.Muted}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="LampNav" Width="9" Height="9" VerticalAlignment="Center"
                         Fill="{DynamicResource Brush.Bad}" />
                <TextBlock x:Name="LampNavText" Text="NAV" FontSize="10" Margin="8,0,0,0"
                           Foreground="{DynamicResource Brush.Muted}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="LampApr" Width="9" Height="9" VerticalAlignment="Center"
                         Fill="{DynamicResource Brush.Bad}" />
                <TextBlock x:Name="LampAprText" Text="APR" FontSize="10" Margin="8,0,0,0"
                           Foreground="{DynamicResource Brush.Muted}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="LampAlt" Width="9" Height="9" VerticalAlignment="Center"
                         Fill="{DynamicResource Brush.Bad}" />
                <TextBlock x:Name="LampAltText" Text="ALT" FontSize="10" Margin="8,0,0,0"
                           Foreground="{DynamicResource Brush.Muted}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="LampVs" Width="9" Height="9" VerticalAlignment="Center"
                         Fill="{DynamicResource Brush.Bad}" />
                <TextBlock x:Name="LampVsText" Text="VS" FontSize="10" Margin="8,0,0,0"
                           Foreground="{DynamicResource Brush.Muted}" />
              </StackPanel>
            </UniformGrid>
          </StackPanel>
        </Border>

        <!-- diagnostics: collapsed by default so the window never scrolls -->
        <Border Style="{StaticResource Card}" Background="Transparent">
          <StackPanel>
            <Border Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnToggleDiagnostics">
              <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Path x:Name="ChevronDiagnostics" Data="M 1,3 L 5,7 L 9,3" Width="10" Height="10"
                        Stroke="{DynamicResource Brush.Muted}" StrokeThickness="1.5"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        RenderTransformOrigin="0.5,0.5" Margin="0,0,8,0">
                    <Path.RenderTransform>
                      <RotateTransform x:Name="ChevronDiagnosticsRotate" Angle="0" />
                    </Path.RenderTransform>
                  </Path>
                  <TextBlock Text="DIAGNOSTICS" FontSize="9" Foreground="{DynamicResource Brush.Dim}"
                             VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="CounterText" Text="-" FontSize="11" HorizontalAlignment="Right"
                           Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <StackPanel x:Name="DiagnosticsBody" Visibility="Collapsed" Margin="0,10,0,0">
              <TextBlock x:Name="ClientText" Text="SimConnect client: -" FontSize="11"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="ErrorText" Text="" FontSize="11" Margin="0,6,0,0"
                         Foreground="{DynamicResource Brush.Warn}" TextWrapping="Wrap" />
              <TextBlock x:Name="SelfTestText" Text="" FontSize="11" Margin="0,8,0,0"
                         Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap"
                         FontFamily="{StaticResource Font.Mono}" Visibility="Collapsed" />
              <Border Background="{DynamicResource Brush.Window}" CornerRadius="8" Margin="0,10,0,0"
                      BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" Padding="8">
                <ScrollViewer x:Name="LogScroll" Height="120" VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Hidden">
                  <TextBlock x:Name="LogText" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                             Foreground="{DynamicResource Brush.Muted}" TextWrapping="NoWrap" />
                </ScrollViewer>
              </Border>
              <TextBlock Text="Open log file" FontSize="9" Margin="0,6,0,0" Cursor="Hand"
                         Foreground="{DynamicResource Brush.Link}" TextDecorations="Underline"
                         MouseLeftButtonUp="OnOpenLogs"
                         ToolTip="Shows the full log, which keeps rotating history" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- settings is an overlay, opened from the footer -->

      </StackPanel>
    </ScrollViewer>

    <!-- footer: settings on the left, actions on the right, on the card grid -->
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock x:Name="VersionText" Text="" FontSize="9"
                   Foreground="{DynamicResource Brush.Dim}" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="FeedbackLink" Margin="0,4,0,0" FontSize="9" Cursor="Hand"
                   Foreground="{DynamicResource Brush.Link}"
                   TextDecorations="Underline"
                   MouseLeftButtonUp="OnSendFeedback"
                   Text="Send comments, bugs, anything" ToolTip="alan@magentadebrief.com" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
        <Button x:Name="PrimaryAction" Style="{StaticResource PrimaryButton}" Click="OnVerifyPanel"
                Margin="0,0,8,0"
                ToolTip="Guided check: press each control and see whether the app receives it">
          <TextBlock x:Name="PrimaryActionText" Text="Test your panel"
                     Foreground="{DynamicResource Brush.OnAccent}" />
        </Button>
        <Button Content="Settings" Click="OnOpenSettings" Margin="0,0,8,0" />
        <Button Content="Reload config" Click="OnReloadConfig" Margin="0,0,8,0" />
        <Button Content="Hide" Click="OnHide" Style="{StaticResource GhostButton}" Margin="0" />
      </StackPanel>
    </Grid>

    <!-- Settings overlay: full-window, grouped like the rest of the Magenta tools -->
    <Border x:Name="SettingsOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
            Background="{DynamicResource Brush.Window}" CornerRadius="8" Padding="24,20,24,18">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
          <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Content="Close" Click="OnCloseSettings" HorizontalAlignment="Right"
                  Style="{StaticResource GhostButton}" Margin="0" />
        </Grid>

        <!-- no ScrollViewer: the window grows to fit the sections instead of scrolling -->
        <StackPanel x:Name="SettingsContent" Grid.Row="1" Margin="0,4,0,4">

            <TextBlock Text="PANEL" FontSize="9" Foreground="{DynamicResource Brush.Dim}" Margin="0,8,0,6" />
            <Grid Margin="0,0,0,6">
              <TextBlock Grid.Column="0" x:Name="SettingsDeviceText" Text="-" FontSize="12"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1" x:Name="SettingsTestButton" Content="TEST PANEL  >"
                      HorizontalAlignment="Right" Click="OnTestFromSettings" />
            </Grid>
            <TextBlock x:Name="SettingsDeviceHint" Text="" FontSize="9"
                       Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" />

            <Border Height="1" Background="{DynamicResource Brush.Stroke}" Margin="0,16,0,0" />

            <TextBlock Text="BRIDGE" FontSize="9" Foreground="{DynamicResource Brush.Dim}" Margin="0,16,0,6" />
            <Grid Margin="0,0,0,8">
              <TextBlock Text="START WITH WINDOWS" FontSize="10"
                         Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
              <Button x:Name="StartupButton" Content="Off" Click="OnToggleStartup"
                      HorizontalAlignment="Right" Padding="12,5" />
            </Grid>
            <Grid Margin="0,0,0,8">
              <TextBlock Text="ALWAYS ON TOP" FontSize="10"
                         Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
              <Button x:Name="TopmostButton" Content="Off" Click="OnToggleTopmost"
                      HorizontalAlignment="Right" Padding="12,5" />
            </Grid>
            <Grid Margin="0,0,0,8">
              <TextBlock Text="THEME" FontSize="10"
                         Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
              <Button x:Name="ThemeButton" Content="Dark" Click="OnToggleTheme"
                      HorizontalAlignment="Right" Padding="12,5" />
            </Grid>
            <TextBlock Text="Launches minimised to the tray and waits for the panel."
                       FontSize="9" Foreground="{DynamicResource Brush.Dim}" TextWrapping="Wrap" />

            <Border Height="1" Background="{DynamicResource Brush.Stroke}" Margin="0,16,0,0" />

            <TextBlock Text="SIMULATOR" FontSize="9" Foreground="{DynamicResource Brush.Dim}" Margin="0,16,0,6" />
            <TextBlock x:Name="SettingsClientText" Text="-" FontSize="10"
                       Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" />
            <TextBlock x:Name="SettingsConfigText" Text="-" FontSize="10" Margin="0,6,0,0"
                       Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" />

            <Border Height="1" Background="{DynamicResource Brush.Stroke}" Margin="0,16,0,0" />

            <TextBlock Text="ABOUT" FontSize="9" Foreground="{DynamicResource Brush.Dim}" Margin="0,16,0,8" />
            <Image x:Name="MagentaLockup" Width="120" Height="19" HorizontalAlignment="Left"
                   Cursor="Hand" ToolTip="magentadebrief.com"
                   MouseLeftButtonUp="OnMagenta"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="A Magenta Debrief tool. Free, no telemetry." FontSize="10"
                       Foreground="{DynamicResource Brush.Muted}" Margin="0,8,0,0" />
            <TextBlock Text="magentadebrief.com" FontSize="9" Margin="0,4,0,0"
                       Foreground="{DynamicResource Brush.Link}" TextDecorations="Underline"
                       Cursor="Hand" MouseLeftButtonUp="OnMagenta" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,8,0,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="SettingsVersionText" Text="" FontSize="9"
                       Foreground="{DynamicResource Brush.Dim}" />
            <TextBlock Text="  ·  " FontSize="9" Foreground="{DynamicResource Brush.Dim}" />
            <TextBlock Text="Tip jar" FontSize="9" Cursor="Hand" ToolTip="magentadebrief.com/donate"
